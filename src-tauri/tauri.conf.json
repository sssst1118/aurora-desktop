{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aurora",
  "version": "0.1.0",
  "identifier": "com.aurora.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "island",
        "title": "Aurora-Island",
        "width": 800,
        "height": 48,
        "x": 0,
        "y": 0,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "visible": true,
        "focus": false,
        "skipTaskbar": true
      },
      {
        "label": "search",
        "title": "Aurora-Search",
        "width": 620,
        "height": 420,
        "center": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "visible": false,
        "skipTaskbar": true
      },
      {
        "label": "dock",
        "title": "Aurora-Dock",
        "width": 800,
        "height": 64,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "visible": false,
        "focus": false,
        "skipTaskbar": true
      },
      {
        "label": "drawer",
        "title": "Aurora-FileDrawer",
        "width": 720,
        "height": 520,
        "center": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "visible": false,
        "skipTaskbar": true
      },
      {
        "label": "clipboard",
        "title": "Aurora-Clipboard",
        "width": 480,
        "height": 560,
        "center": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "visible": false,
        "skipTaskbar": true
      },
      {
        "label": "ai_panel",
        "title": "Aurora-AI",
        "width": 540,
        "height": 680,
        "center": true,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": false,
        "resizable": false,
        "visible": false,
        "skipTaskbar": true
      },
      {
        "label": "wallpaper",
        "title": "Aurora-Wallpaper",
        "width": 1920,
        "height": 1080,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": false,
        "resizable": false,
        "visible": false,
        "skipTaskbar": true,
        "focus": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$USERPROFILE/Pictures/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": ["icons/icon.ico"],
    "publisher": "Aurora Desktop",
    "copyright": "Copyright © 2026 sssst1118",
    "category": "Utility",
    "shortDescription": "Aurora - AI 增强模块化桌面效率中心",
    "longDescription": "灵动岛 / Dock / 全局搜索 / 文件抽屉 / 剪贴板历史 / 壁纸引擎 / AI 助手"
  }
}
